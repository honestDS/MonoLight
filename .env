# 数据库连接配置
# 默认使用 SQLite (异步驱动: aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./data/monolight.db
# MySQL 示例: DATABASE_URL=mysql+aiomysql://username:password@127.0.0.1:3306/monolight
# PostgreSQL 示例: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/monolight

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 应用程序运行端口 (强制配置，无默认值)
APP_PORT=8001

# 系统预留的超级管理员用户名。
# 该字段有两个核心作用：
# 1. 作为系统鉴权的“锚点”，标识谁拥有最高解释权。
# 2. 在调用 /reset_admin 接口时，系统将根据此字段定位需要重置的目标账户名。
ADMIN_USERNAME=admin

# 安全配置
# JWT 签名密钥
JWT_SECRET_KEY=UGNOvsDh371_1upgMs8yGgZHELcW-FTL64QvvHSJHKc
# JWT 加密算法
JWT_ALGORITHM=HS256
# Token 有效期 (单位: 分钟，10080 为 7 天)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 超级管理员重置 Token (用于紧急恢复)
ADMIN_RESET_TOKEN=ed126d6c5a4ea6bf33774214633d2a16

# API密钥加密密钥 (256位十六进制)
MONOLIGH_ENCRYPTION_KEY=a3f7b2c8e9d4f1a6b5c3d7e2f8a1b4c6d9e3f7a2b8c5d1e6f3a7b2c9d4e8f1a5

# 日志文件存储路径
LOG_FILE_PATH=data/logs/monolight.log
# 日志记录级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# 时区 8=东八区
LOG_TZ_OFFSET=8
