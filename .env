# 数据库连接配置
# 默认使用 SQLite (异步驱动: aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./monobot.db
# MySQL 示例: mysql+aiomysql://username:password@127.0.0.1:3306/database

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 应用程序运行端口 (强制配置，无默认值)
APP_PORT=8001

# 系统预留的超级管理员用户名。
# 该字段有两个核心作用：
# 1. 作为系统鉴权的“锚点”，标识谁拥有最高解释权。
# 2. 在调用 /reset_admin 接口时，系统将根据此字段定位需要重置的目标账户名。
ADMIN_USERNAME=admin

# 安全配置
# JWT 签名密钥
JWT_SECRET_KEY=UGNOvsDh371_1upgMs8yGgZHELcW-FTL64QvvHSJHKc
# JWT 加密算法
JWT_ALGORITHM=HS256
# Token 有效期 (单位: 分钟，10080 为 7 天)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 算法系数配置 (可选配置，控制 ContextManager Token 估算精度)
# 中文字符系数 (默认 0.6)
# TOKEN_COEFF_CHINESE=0.6
# 其他字符系数 (默认 0.3)
# TOKEN_COEFF_OTHER=0.3
# 超级管理员重置 Token (用于紧急恢复)
ADMIN_RESET_TOKEN=ed126d6c5a4ea6bf33774214633d2a16

# 日志文件存储路径
LOG_FILE_PATH=data/logs/monobot.log
# 日志记录级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
