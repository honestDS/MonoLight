# 数据库连接配置
# 默认使用 SQLite (异步驱动: aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./data/monolight.db
# MySQL 示例: DATABASE_URL=mysql+aiomysql://username:password@127.0.0.1:3306/monolight

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 应用程序运行端口 (强制配置，无默认值)
APP_HOST=0.0.0.0
APP_PORT=8001
APP_WORKERS=1

# 通知中心配置：默认单机；远程访问仅限可信内网或加密隧道
# 本机中心监听 IP；主节点跨机使用时可改为 0.0.0.0 或内网 IP
NOTIFICATION_HOST=127.0.0.1
NOTIFICATION_PORT=8766
# 留空由本机启动中心；填主节点 IP 则仅连接该中心，支持 IPv4/IPv6，不写 Web URL 或端口
NOTIFICATION_SERVER_HOST=
# 可选 64 位十六进制通知凭证，各节点需相同；留空从现有系统密钥派生
NOTIFICATION_TOKEN=

# 前后端分离部署配置
# 默认保持注释时为一体化同源部署；仅前后端分离部署时取消注释
# 以下变量为前端构建期配置，启用或修改后需要重新运行前端构建
# VUE_APP_API_BASE_URL=https://api.example.com/api/v1
# VUE_APP_WS_BASE_URL=wss://api.example.com

# 安全配置
# Token 有效期 (单位: 分钟，10080 为 7 天)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 日志文件存储路径
LOG_FILE_PATH=data/logs/monolight.log
# 时区 8=东八区
LOG_TZ_OFFSET=8

# Token 估算系数
TOKEN_COEFF_CHINESE=1.5
TOKEN_COEFF_OTHER=0.3
